FROM python:3.13-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
WORKDIR /app
RUN test -s "$SSL_CERT_FILE" && groupadd --gid 10001 app && useradd --uid 10001 --gid app --no-create-home app
COPY backend/requirements.txt ./
RUN python -m pip install --no-cache-dir -r requirements.txt
COPY backend/member_profile.py backend/member_profile_store.py backend/signup_views.py backend/db.py backend/auth_core.py backend/auth_http.py backend/oauth_providers.py backend/oauth_store.py backend/oauth_http.py backend/portal.py backend/portal_store.py backend/monthly_portal.py backend/monthly_store.py backend/manual_models.py backend/manual_store.py backend/manual_portal.py backend/portal_entry.py backend/portal_readiness.py ./
COPY backend/portal_static/ ./portal_static/
USER 10001:10001
EXPOSE 8080
CMD ["python", "-m", "portal_readiness"]
